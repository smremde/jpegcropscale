{
  "name": "@smremde/jpegcropscale",
  "version": "1.0.1",
  "description": "High-performance JPEG crop and power-of-two downscale library powered by libjpeg-turbo compiled to WebAssembly.",
  "main": "./dist/node/index.js",
  "exports": {
    "node": {
      "require": "./dist/node/index.js"
    },
    "browser": {
      "import": "./dist/web/index.mjs"
    },
    "worker": {
      "import": "./dist/worker/index.mjs"
    },
    "default": "./dist/node/index.js"
  },
  "scripts": {
    "test": "node test/test.js"
  },
  "keywords": [
    "jpeg",
    "crop",
    "scale",
    "downscale",
    "resize",
    "wasm",
    "webassembly",
    "libjpeg-turbo",
    "turbojpeg",
    "performance"
  ],
  "author": "Stephen Remde",
  "license": "MIT",
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": "github:smremde/jpegcropscale",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "semantic-release": "^25.0.5"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": true
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
